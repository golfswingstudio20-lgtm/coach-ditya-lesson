{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": [
        "sin1"
    ],
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/",
            "dest": "/api/index.php"
        },
        {
            "src": "/(.*)\\.php",
            "dest": "/api/index.php"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "crons": [
        {
            "path": "/cron/bersihkan-storage",
            "schedule": "0 19 * * *"
        },
        {
            "path": "/cron/bersihkan-notifikasi",
            "schedule": "0 20 * * *"
        },
        {
            "path": "/cron/agenda-harian",
            "schedule": "0 23 * * *"
        },
        {
            "path": "/cron/pengingat-lesson",
            "schedule": "0 10 * * *"
        },
        {
            "path": "/cron/laporan-mingguan",
            "schedule": "0 1 * * 1"
        },
        {
            "path": "/cron/laporan-bulanan",
            "schedule": "0 1 1 * *"
        }
    ]
}
